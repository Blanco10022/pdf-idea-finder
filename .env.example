# AI polish is optional. Without any key, the app runs data-only (all numbers
# still come from real search data; titles come from the top real query).
# If both keys are set, Gemini is used.

# --- Option A: Google Gemini (free, no card) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest)
GEMINI_MODEL=

# --- Option B: Groq (free, fast) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-120b)
GROQ_MODEL=

# --- Option C: Claude (paid) ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-4-8)
CLAUDE_MODEL=

# With two or more AI keys set, the app runs "compare + pick best":
# each model writes ideas, then the most capable one judges/merges them.

# --- Optional data sources (each self-activates when set) ---
# YouTube view counts: enable "YouTube Data API v3" in Google Cloud, make an API key
YOUTUBE_API_KEY=
# Reddit questions: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_SECRET=

# Port to listen on (hosts like Render set this automatically)
PORT=3000
